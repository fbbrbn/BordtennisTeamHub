{
  "name": "bordtennis-team-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial team analytics and lineup planning for Danish table tennis team tournaments (data from bordtennisportalen.dk).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scraper",
    "import": "node scraper/import.ts",
    "data:pull": "mkdir -p public/data && git fetch --depth 1 origin data && git archive FETCH_HEAD | tar -x -C public/data",
    "history:pull": "bash scripts/pull-history.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "node-html-parser": "^9.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
